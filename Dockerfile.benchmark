FROM node:22-bookworm-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
RUN npm ci
RUN npm exec --workspace=server -- playwright install --with-deps chromium
COPY apps/server/benchmarks apps/server/benchmarks
RUN node apps/server/benchmarks/setup-candidates.js

# The benchmark uses fresh temporary profiles; mount /app/artifacts to retain evidence.
ENTRYPOINT ["node", "apps/server/benchmarks/run.js"]
